extends SceneTree
## Run with --headless --path <project> --script res://tests/progression_checks.gd
const MANAGER = preload("res://scripts/progression_manager.gd")
const PLAYER = preload("res://scripts/player.gd")
const NEXUS = preload("res://ui/echo_nexus/echo_nexus.tscn")
var failures := 0
var checks := 0

func check(condition: bool, description: String) -> void:
	checks += 1
	if condition:
		print("PASS: ", description)
	else:
		failures += 1
		push_error("FAIL: " + description)

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var directory := OS.get_environment("REBOUND_TEST_DIR")
	if directory.is_empty():
		directory = OS.get_user_data_dir()
	var path := directory.path_join("rebound-test-%d.json" % OS.get_process_id())
	var manager := MANAGER.new(path)
	manager.auto_save = false
	root.add_child(manager)
	var player := PLAYER.new()
	root.add_child(player)
	player.set_physics_process(false)
	manager.set_process(false)
	manager.bind_player(player)
	check(not player.dash_unlocked and not player.slam_unlocked and not player.double_jump_unlocked, "advanced abilities locked by default")
	check(manager.get_upgrade_definitions().size() == 11, "all eleven Nexus definitions present")
	check(manager.get_node_state("double_jump") == "available", "Double Jump initially available")
	check(not manager.try_unlock_node("double_jump"), "insufficient funds reject purchase")
	check(not manager.try_unlock_node("air_dash") and not manager.try_unlock_node("ground_slam"), "challenge abilities cannot be bought prematurely")
	check(manager.add_coins(2000, "test/grant"), "generic currency grant")
	check(not manager.add_coins(2000, "test/grant"), "duplicate grant rejected")
	check(not manager.add_coins(-100, "bad"), "negative grants rejected")
	check(manager.get_node_state("coin_magnet") == "locked", "balance alone never unlocks magnet")
	for i in range(10):
		manager.collect_coin("chunk/1/coin/%d" % i)
	check(manager.get_coin_balance() == 2050 and manager.stats["world_coin_pickups"] == 10, "ten actual objects award fifty coins and count pickups")
	check(not manager.collect_coin("chunk/1/coin/0") and manager.stats["world_coin_pickups"] == 10, "duplicate coin cannot increment statistics")
	check(manager.try_unlock_node("coin_magnet") and player.coin_magnet_radius == 90.0, "magnet unlock and radius")
	var before: int = manager.get_coin_balance()
	check(manager.try_unlock_node("double_jump") and manager.get_coin_balance() == before - 100 and player.double_jump_unlocked, "purchase debits exact cost and applies Double Jump")
	check(not manager.try_unlock_node("double_jump"), "duplicate purchase rejected")
	check(not manager.try_unlock_node("energy_booster") and not manager.try_unlock_node("spring_mastery"), "upgrade prerequisites and Comeback gate enforced")
	before = manager.get_coin_balance()
	player.die()
	check(manager.get_coin_balance() == before and manager.stats["comebacks"] == 0, "death never rewards Comeback or erases coins")
	player.respawn(Vector2.ZERO)
	check(player.double_jump_unlocked, "permanent ability survives death")
	check(manager.complete_comeback("chunk/1/comeback/1") and manager.get_coin_balance() == before + 25, "successful Comeback rewards twenty-five")
	check(not manager.complete_comeback("chunk/1/comeback/1"), "Comeback reward is idempotent")
	check(manager.try_unlock_node("spring_mastery") and player.perfect_window_msec == 150, "Spring Mastery widens timing")
	check(manager.try_unlock_node("energy_booster") and player.energy_gain_multiplier == 1.25, "Energy Booster applies")
	check(manager.try_unlock_node("echo_overdrive") and player.overdrive_unlocked, "Overdrive unlock prerequisites")
	before = manager.get_coin_balance()
	check(manager.complete_challenge("velocity_trial") and player.dash_unlocked and manager.get_coin_balance() == before + 40, "Velocity Trial unlocks dash and rewards forty")
	check(not manager.complete_challenge("velocity_trial"), "challenge reward is idempotent")
	check(manager.try_unlock_node("dash_amplifier") and is_equal_approx(player.dash_distance_multiplier, 1.15), "Dash Amplifier applies")
	check(manager.complete_challenge("impact_trial") and player.slam_unlocked, "Impact Trial unlocks slam")
	check(manager.try_unlock_node("slam_pulse") and player.slam_pulse_radius == 120.0, "Slam Pulse exposes radius")
	check(not manager.complete_challenge("typo_trial"), "unknown challenges rejected")
	check(manager.complete_challenge("momentum_trial") and manager.complete_challenge("ascension/chapter1"), "Momentum and Ascension rewards")
	check(manager.enter_biome("pulse_caverns") and not manager.enter_biome("pulse_caverns"), "biome discovery is unique")
	before = manager.get_coin_balance()
	check(manager.reward_perfect_rebound("chunk/1/spring/1") and not manager.reward_perfect_rebound("chunk/1/spring/1") and manager.get_coin_balance() == before + 10, "unique perfect spring reward")
	manager.bind_player(player)
	manager.bind_player(player)
	check(player.energy_gain_multiplier == 1.25 and player.dash_distance_multiplier == 1.15, "rebinding never stacks upgrades")
	var style_before: int = manager.stats["total_style_points"]
	player.award_style_points(10, "test")
	check(manager.stats["total_style_points"] == style_before + 10, "rebinding never duplicates event subscriptions")
	var replacement := PLAYER.new()
	root.add_child(replacement)
	replacement.set_physics_process(false)
	manager.bind_player(replacement)
	check(replacement.dash_unlocked and replacement.slam_unlocked and replacement.double_jump_unlocked and replacement.perfect_window_msec == 150, "replacement player receives progression")
	style_before = manager.stats["total_style_points"]
	player.award_style_points(10, "old_player")
	check(manager.stats["total_style_points"] == style_before, "old player disconnected")
	check(manager.save_progression(), "versioned atomic save succeeds")
	var saved_coins: int = manager.get_coin_balance()
	var other := MANAGER.new(path)
	other.auto_save = false
	root.add_child(other)
	check(other.get_coin_balance() == saved_coins and other.get_node_state("echo_overdrive") == "unlocked", "save/load retains balance and purchase prerequisites")
	check(not other.collect_coin("chunk/1/coin/0") and not other.complete_comeback("chunk/1/comeback/1"), "reward IDs survive save/load")
	other.retire_chunks_through(1)
	check(not other.collect_coin("chunk/1/coin/new") and other.collect_coin("chunk/2/coin/new"), "retired chunks reject old rewards while new chunks work")
	check(other._sources.size() < manager._sources.size(), "chunk retirement bounds source storage")
	check(other.save_progression(), "repeated save preserves backup")
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string("{broken json")
	file.close()
	check(other.load_progression() and other.get_coin_balance() == saved_coins, "corrupt primary recovers previous backup")
	var bad := MANAGER.new(path + ".missing")
	bad.auto_save = false
	root.add_child(bad)
	check(bad.get_coin_balance() == 0 and bad.get_node_state("basic_movement") == "unlocked", "missing save starts safely")
	# UI tests exercise actual Control nodes and pause ownership, without claiming
	# headless rendering verifies appearance.
	var overlay := NEXUS.instantiate()
	root.add_child(overlay)
	overlay.bind_progression(manager)
	check(overlay._buttons.size() == 11, "UI creates all eleven interactive nodes")
	overlay.open_tree()
	check(paused and not replacement.active and overlay.visible, "opening tree pauses gameplay and player")
	var combo_before: float = replacement._combo_remaining
	replacement._physics_process(0.5)
	check(replacement._combo_remaining == combo_before, "open tree freezes movement timers")
	overlay.close_tree()
	check(not paused and replacement.active and replacement._resume_input_guard, "closing tree resumes with guarded input")
	paused = true
	overlay.open_tree()
	overlay.close_tree()
	check(paused, "closing tree preserves pre-existing pause")
	paused = false
	check(other.get_coin_balance() >= 0, "balance remains nonnegative")
	# Actual coin component, rather than using account balance as pickup count.
	replacement.respawn(Vector2(500, 100))
	var coin = load("res://scripts/echo_coin.gd").new()
	coin.configure(manager, "chunk/2/coin/magnet_test")
	coin.position = Vector2(580, 100)
	root.add_child(coin)
	before = manager.get_coin_balance()
	coin._physics_process(0.1)
	check(coin.position.x < 580.0, "magnet physically attracts nearby coins")
	coin._physics_process(1.0)
	check(manager.get_coin_balance() == before + 5, "magnet pickup uses economy and collision eligibility")
	# A malformed save without a backup starts from safe defaults.
	var invalid_file := FileAccess.open(path + ".invalid", FileAccess.WRITE)
	invalid_file.store_string("{broken}")
	invalid_file.close()
	var invalid := MANAGER.new(path + ".invalid")
	invalid.auto_save = false
	root.add_child(invalid)
	check(invalid.get_coin_balance() == 0 and invalid.get_node_state("air_dash") == "locked", "invalid save without backup starts safely")
	check(manager.get_upgrade_definitions()["dash_amplifier"]["effects"]["dash_distance_multiplier"] == 1.15, "definitions expose structured effects and IDs")
	bad.add_coins(100, "ui/grant")
	bad.bind_player(replacement)
	overlay.bind_progression(bad)
	overlay._select("double_jump")
	check(not overlay._purchase.disabled, "UI enables affordable eligible purchase")
	overlay._purchase.pressed.emit()
	check(bad.get_coin_balance() == 0 and replacement.double_jump_unlocked and overlay._purchase.disabled and overlay._purchase.text == "Unlocked", "UI purchase updates balance, player, and button immediately")
	overlay._select("spring_mastery")
	check(overlay._requirements.text.contains("75") and overlay._requirements.text.contains("Comeback"), "locked UI details show cost and unmet requirement")
	print("PROGRESSION CHECKS: %d passed, %d failed" % [checks - failures, failures])
	quit(0 if failures == 0 else 1)
